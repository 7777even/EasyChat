<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.6.1</version>
        <relativePath/>
    </parent>

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.easychat</groupId>
    <artifactId>easychat</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>
    <name>easychat</name>
    <description>easychat</description>

    <properties>
	 <codeversion>9425581304</codeversion>
        <!-- 2026-10-03：1.8 → 17（对齐 CI 与 Dockerfile，消除本地 JDK17 / CI JDK8 的漂移）。
             连带修掉两个真实问题：
               ① maven.compiler.source/target 显式写死 1.8，覆盖了 parent 的 java.version，
                  造成「改了 java.version 却毫无作用」的假象；
               ② 旧目标下 pom 给 spring-boot 插件配了仅 JDK9+ 支持的模块开放参数，
                  使 `mvn spring-boot:run` 在 JDK 8 上直接启动失败，而 CI 只跑 test/package 照不到。
             JDK 11+ 移除了 java.xml.ws.annotation，但 jakarta.annotation-api 1.3.5
             仍以 javax.annotation 包提供 Resource/PostConstruct，编译不受影响（已实测）。 -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <skipTests>false</skipTests>
        <codeversion>7164461598</codeversion>
        <springboot.version>2.6.1</springboot.version>
        <mybatis.version>1.3.2</mybatis.version>
        <logback.version>1.2.10</logback.version>
        <mysql.version>8.0.23</mysql.version>
        <aspectjweaver.version>1.9.4</aspectjweaver.version>
        <okhttp3.version>3.2.0</okhttp3.version>
        <fastjson.version>1.2.66</fastjson.version>
        <commons.lang3.version>3.4</commons.lang3.version>
        <commons.codec.version>1.9</commons.codec.version>
        <commons.io.version>2.5</commons.io.version>
        <captcha.verion>1.6.2</captcha.verion>
        <netty.version>4.1.50.Final</netty.version>
        <redisson.version>3.12.3</redisson.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-classic</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>ch.qos.logback</groupId>
                    <artifactId>logback-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--redis -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <version>${springboot.version}</version>
        </dependency>
        <!--mybatis-->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis.version}</version>
        </dependency>


        <!-- 数据库-->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>${mysql.version}</version>
        </dependency>


        <!-- 日志版本 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <version>${logback.version}</version>
        </dependency>

        <!--切面-->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <version>${aspectjweaver.version}</version>
        </dependency>

        <!--okhttp-->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp3.version}</version>
        </dependency>

        <!--fastjson-->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>fastjson</artifactId>
            <version>${fastjson.version}</version>
        </dependency>

        <!--apache common-->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons.lang3.version}</version>
        </dependency>

        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>${commons.codec.version}</version>
        </dependency>

        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons.io.version}</version>
        </dependency>

        <!--验证码-->
        <dependency>
            <groupId>com.github.whvcse</groupId>
            <artifactId>easy-captcha</artifactId>
            <version>${captcha.verion}</version>
        </dependency>

        <!--netty-->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>${netty.version}</version>
        </dependency>

        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>${redisson.version}</version>
        </dependency>

        <!-- Spring Security Crypto（BCrypt 密码加密） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- 邮件发送（邮箱验证码真实投递）
             2026-10-03 新增，属 AGENTS §8「生产依赖新增」L4，已过人工确认关卡。
             刻意不写 <version>：版本由 parent spring-boot-starter-parent 2.6.1 统一管理，
             手写版本号会与 parent 漂移（与 spring-boot-maven-plugin 锁 2.2.6 的教训同类）。
             动机：改造前 sendEmailCode 把验证码明文写日志，日志读权限 = 任意账号改密权限。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Flyway 数据库迁移自动化（2026-10-04，L4）
             动机：迁移执行链路缺最后一环——verify_schema_drift.mjs 能「发现」
             「改了基线但没迁移」，但没有任何东西**执行**迁移，也没有账本记录
             「某个库应用到第几号」，该状态只存在于人脑。已造成两次真实事故
             （BCrypt 列宽截断 500、四张表存量库不存在）。

             ⚠⚠ 为何必须显式钉 7.15.0（2026-10-04 实测结论，勿「顺手」改回）：
               1. parent 2.6.1 管理的 flyway-core 是 **8.0.4**，而 **Flyway Community
                  从 8.0 起不再支持 MySQL 5.7**（5.7 仅保留在付费 Teams 版）。
                  实测报错 FlywayEditionUpgradeRequiredException:
                  "MySQL 5.7 is no longer supported by Flyway Community Edition"。
               2. 本项目**本机开发库就是 MySQL 5.7**（docker-compose 用 8.0，两边本就不一致），
                  随 parent 走 8.0.4 会让**开发者本地根本起不来**。
               3. 7.15.0 是最后一个在 Community 下同时支持 MySQL 5.7 与 8.0 的版本。

               因此这里**刻意手写版本号**覆盖 parent —— 与本仓「依赖版本一律由 parent 管理」的
               取向相反，是一次有实测依据的例外。升级 Flyway 前必须先确认目标版本
               是否恢复了对 5.7 的支持。
               证据：engineering/qa/2026-10-04-flyway-t0.3b-baseline-imported.txt -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>7.15.0</version>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- 默认资源（src/main/resources） -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- 迁移脚本：源在**仓库根**（AGENTS §6.4-2 规定的命名与位置），
                 这里复制进 jar 的 db/migration，使 dev 直跑与打包运行
                 **同一套** classpath:db/migration 路径，不依赖运行期 CWD。
                 文件名**零改动**（不改名、不删 003 那个纯注释占位）。
                 见 openspec/changes/2026-10-04-flyway-migration-automation ADR-001/002。 -->
            <resource>
                <directory>${project.basedir}/..</directory>
                <includes>
                    <include>easychat-migration-*.sql</include>
                </includes>
                <targetPath>db/migration</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- 2026-10-03：删除显式 <version>2.2.6.RELEASE</version>。
                     原先它与 parent 2.6.1 倒挂，产物是「loader 2.2.6 去跑 2.6.1 的类」——
                     既不保证能跑，也不保证 boot loader 与 Boot 版本匹配。
                     不写版本号即由 parent 统一管理，与 spring-boot-starter-mail 等依赖同一口径。 -->
                <configuration>
                    <mainClass>com.easychat.EasyChatApplication</mainClass>
                    <!-- Redisson FST 编码在 JDK 17 强封装下需要开放模块访问权限。
                         java.version 已升到 17，故此参数是必需项而非兼容性残留。
                         注：本注释刻意不写模块开放参数的原文字面量，XML 注释内不允许连续两个连字符。 -->
                    <jvmArguments>--add-opens java.base/java.lang=ALL-UNNAMED --add-opens java.base/java.util=ALL-UNNAMED --add-opens java.base/java.math=ALL-UNNAMED</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
