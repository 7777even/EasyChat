<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.easychat.mappers.GroupFileMapper">

    <!--实体映射-->
    <resultMap id="base_result_map" type="com.easychat.entity.po.GroupFile">
        <result column="id" property="id"/>
        <result column="group_id" property="groupId"/>
        <result column="file_name" property="fileName"/>
        <result column="file_path" property="filePath"/>
        <result column="file_size" property="fileSize"/>
        <result column="file_type" property="fileType"/>
        <result column="cover_path" property="coverPath"/>
        <result column="upload_user_id" property="uploadUserId"/>
        <result column="uploadUserNickName" property="uploadUserNickName"/>
        <result column="create_time" property="createTime"/>
        <result column="status" property="status"/>
    </resultMap>

    <!-- 通用查询结果列-->
    <sql id="base_column_list">
        id
        ,group_id,file_name,file_path,file_size,file_type,cover_path,upload_user_id,create_time,status
    </sql>

    <sql id="base_condition_filed">
        <if test="query.id != null">
            and id = #{query.id}
        </if>
        <if test="query.idAnd != null">
            and id = #{query.idAnd}
        </if>
        <if test="query.groupId != null and query.groupId!=''">
            and group_id = #{query.groupId}
        </if>
        <if test="query.fileName != null and query.fileName!=''">
            and file_name = #{query.fileName}
        </if>
        <if test="query.fileType != null">
            and file_type = #{query.fileType}
        </if>
        <if test="query.uploadUserId != null and query.uploadUserId!=''">
            and upload_user_id = #{query.uploadUserId}
        </if>
        <if test="query.status != null">
            and status = #{query.status}
        </if>
    </sql>

    <!-- 通用查询条件列-->
    <sql id="query_condition">
        <where>
            <include refid="base_condition_filed"/>
            <if test="query.groupIdFuzzy!= null  and query.groupIdFuzzy!=''">
                and group_id like concat('%', #{query.groupIdFuzzy}, '%')
            </if>
            <if test="query.fileNameFuzzy!= null  and query.fileNameFuzzy!=''">
                and file_name like concat('%', #{query.fileNameFuzzy}, '%')
            </if>
            <if test="query.uploadUserIdFuzzy!= null  and query.uploadUserIdFuzzy!=''">
                and upload_user_id like concat('%', #{query.uploadUserIdFuzzy}, '%')
            </if>
        </where>
    </sql>

    <!-- 查询集合-->
    <select id="selectList" resultMap="base_result_map">
        SELECT
        <include refid="base_column_list"/>
        <if test="query.queryUploadUserInfo">
            ,(select nick_name from user_info u where u.user_id = gf.upload_user_id) uploadUserNickName
        </if>
        FROM group_file gf
        <include refid="query_condition"/>
        <if test="query.orderBy!=null">
            order by ${query.orderBy}
        </if>
        <if test="query.simplePage!=null">
            limit #{query.simplePage.start},#{query.simplePage.end}
        </if>
    </select>

    <!-- 查询数量-->
    <select id="selectCount" resultType="java.lang.Integer">
        SELECT count(1) FROM group_file
        <include refid="query_condition"/>
    </select>

    <!-- 根据ID获取对象-->
    <select id="selectById" resultMap="base_result_map">
        select
        <include refid="base_column_list"/>
        from group_file where id = #{id}
    </select>

    <!-- 插入 （匹配有值的字段）-->
    <insert id="insert" parameterType="com.easychat.entity.po.GroupFile" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO group_file
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="bean.groupId != null">
                group_id,
            </if>
            <if test="bean.fileName != null">
                file_name,
            </if>
            <if test="bean.filePath != null">
                file_path,
            </if>
            <if test="bean.fileSize != null">
                file_size,
            </if>
            <if test="bean.fileType != null">
                file_type,
            </if>
            <if test="bean.coverPath != null">
                cover_path,
            </if>
            <if test="bean.uploadUserId != null">
                upload_user_id,
            </if>
            <if test="bean.createTime != null">
                create_time,
            </if>
            <if test="bean.status != null">
                status,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="bean.groupId!=null">
                #{bean.groupId},
            </if>
            <if test="bean.fileName!=null">
                #{bean.fileName},
            </if>
            <if test="bean.filePath!=null">
                #{bean.filePath},
            </if>
            <if test="bean.fileSize!=null">
                #{bean.fileSize},
            </if>
            <if test="bean.fileType!=null">
                #{bean.fileType},
            </if>
            <if test="bean.coverPath!=null">
                #{bean.coverPath},
            </if>
            <if test="bean.uploadUserId!=null">
                #{bean.uploadUserId},
            </if>
            <if test="bean.createTime!=null">
                #{bean.createTime},
            </if>
            <if test="bean.status!=null">
                #{bean.status},
            </if>
        </trim>
    </insert>

    <!--多条件修改（软删除 / 字段更新）-->
    <update id="updateByParam" parameterType="com.easychat.entity.query.GroupFileQuery">
        UPDATE group_file
        <set>
            <if test="bean.fileName != null">
                file_name = #{bean.fileName},
            </if>
            <if test="bean.filePath != null">
                file_path = #{bean.filePath},
            </if>
            <if test="bean.fileSize != null">
                file_size = #{bean.fileSize},
            </if>
            <if test="bean.fileType != null">
                file_type = #{bean.fileType},
            </if>
            <if test="bean.coverPath != null">
                cover_path = #{bean.coverPath},
            </if>
            <if test="bean.uploadUserId != null">
                upload_user_id = #{bean.uploadUserId},
            </if>
            <if test="bean.createTime != null">
                create_time = #{bean.createTime},
            </if>
            <if test="bean.status != null">
                status = #{bean.status},
            </if>
        </set>
        <include refid="query_condition"/>
    </update>

</mapper>
