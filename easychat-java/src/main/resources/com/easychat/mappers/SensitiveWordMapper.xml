<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.easychat.mappers.SensitiveWordMapper">

    <resultMap id="base_result_map" type="com.easychat.entity.po.SensitiveWord">
        <result column="id" property="id"/>
        <result column="word" property="word"/>
        <result column="level" property="level"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="base_column_list">
        id, word, level, status, create_time
    </sql>

    <select id="selectByStatus" resultMap="base_result_map">
        SELECT
        <include refid="base_column_list"/>
        FROM sensitive_word
        WHERE status = #{status}
    </select>

</mapper>
