<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.easychat.mappers.FavoriteMapper">

    <resultMap id="BaseResultMap" type="com.easychat.entity.po.Favorite">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="message_id" property="messageId"/>
        <result column="content" property="content"/>
        <result column="file_path" property="filePath"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, message_id, content, file_path, create_time
    </sql>

    <insert id="insert" parameterType="com.easychat.entity.po.Favorite" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO favorite (user_id, message_id, content, file_path, create_time)
        VALUES (#{userId}, #{messageId}, #{content}, #{filePath}, #{createTime})
    </insert>

    <delete id="deleteById">
        DELETE FROM favorite WHERE id = #{id}
    </delete>

    <select id="selectList" resultMap="BaseResultMap" parameterType="com.easychat.entity.query.FavoriteQuery">
        SELECT <include refid="Base_Column_List"/>
        FROM favorite
        <where>
            <if test="userId != null and userId != ''">
                AND user_id = #{userId}
            </if>
            <if test="messageId != null">
                AND message_id = #{messageId}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectCount" resultType="java.lang.Integer" parameterType="com.easychat.entity.query.FavoriteQuery">
        SELECT COUNT(*)
        FROM favorite
        <where>
            <if test="userId != null and userId != ''">
                AND user_id = #{userId}
            </if>
            <if test="messageId != null">
                AND message_id = #{messageId}
            </if>
        </where>
    </select>

</mapper>
