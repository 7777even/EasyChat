<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.easychat.mappers.UserStatusMapper">

    <resultMap id="BaseResultMap" type="com.easychat.entity.po.UserStatus">
        <id column="user_id" property="userId"/>
        <result column="content" property="content"/>
        <result column="image_url" property="imageUrl"/>
        <result column="create_time" property="createTime"/>
        <result column="expire_time" property="expireTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        user_id, content, image_url, create_time, expire_time
    </sql>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user_status
        WHERE user_id = #{userId}
    </select>

    <insert id="insert" parameterType="com.easychat.entity.po.UserStatus">
        INSERT INTO user_status (user_id, content, image_url, create_time, expire_time)
        VALUES (#{bean.userId}, #{bean.content}, #{bean.imageUrl}, #{bean.createTime}, #{bean.expireTime})
    </insert>

    <update id="updateByParam" parameterType="map">
        UPDATE user_status
        <set>
            <if test="bean.content != null">content = #{bean.content},</if>
            <if test="bean.imageUrl != null">image_url = #{bean.imageUrl},</if>
            <if test="bean.createTime != null">create_time = #{bean.createTime},</if>
            <if test="bean.expireTime != null">expire_time = #{bean.expireTime},</if>
        </set>
        WHERE user_id = #{bean.userId}
    </update>

    <delete id="deleteByUserId">
        DELETE FROM user_status WHERE user_id = #{userId}
    </delete>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user_status
        <where>
            <if test="query.userId != null">AND user_id = #{query.userId}</if>
        </where>
    </select>

    <select id="selectCount" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM user_status
        <where>
            <if test="query.userId != null">AND user_id = #{query.userId}</if>
        </where>
    </select>

</mapper>
