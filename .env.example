# =====================================================================
# EasyChat 运行时凭据模板
# =====================================================================
# 用法：
#   1) cp .env.example .env
#   2) 填入真实值
#   3) 注入方式二选一：
#      a) docker compose --env-file .env up -d     （compose 自动读取）
#      b) set -a; . ./.env; set +a; mvn spring-boot:run   （shell 手动导出）
#
# ⚠️ 三条纪律：
#   1. .env 已被 .gitignore 排除，**禁止**提交；
#   2. 本文件（.env.example）只放占位值，可入库；
#   3. Spring Boot 2.6 **不会自动读取 .env**（自动导入是 3.0+ 的
#      spring.config.import 特性），必须用上面 (a) 或 (b) 的方式注入。
#
# 生效需要 SPRING_PROFILES_ACTIVE=prod（默认是 dev）。
# =====================================================================

SPRING_PROFILES_ACTIVE=prod

# ---------- 数据库 ----------
# 留空则 prod profile 下启动失败（刻意设计：生产禁止默认可用凭据）
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/easychat?serverTimezone=GMT%2B8&useUnicode=true&characterEncoding=utf8&useSSL=false
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# ---------- Redis ----------
SPRING_REDIS_HOST=127.0.0.1
SPRING_REDIS_PORT=6379

# ---------- 文件落盘根目录（生产必须指向持久化卷） ----------
PROJECT_FOLDER=/data/

# ---------- 超级管理员邮箱（多个用逗号分隔） ----------
EASYCHAT_ADMIN_EMAILS=CHANGE_ME

# ---------- 邮件服务（邮箱验证码真实投递，2026-10-03 新增） ----------
# ⚠️ 留空 = fail-closed：/account/sendEmailCode 返回 CODE_1002 并拒绝发送，
#    **不会**退回「把验证码写进日志」（日志读权限 = 任意账号改密权限）。
#    生产必须自建 SMTP 并填入；不填则找回密码功能显式不可用（预期行为）。
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=CHANGE_ME
SPRING_MAIL_PASSWORD=CHANGE_ME
SPRING_MAIL_FROM=CHANGE_ME

# ---------- TURN 中继（音视频通话） ----------
# 生产必须自建 coturn，**禁止**沿用任何公共中继服务器。
# 三项留空则降级为纯 STUN：多数 NAT 可用，对称 NAT 下通话不通（预期行为）。
# EASYCHAT_TURN_URL=turn:your-turn-host:3478?transport=udp
# EASYCHAT_TURN_USERNAME=CHANGE_ME
# EASYCHAT_TURN_CREDENTIAL=CHANGE_ME
